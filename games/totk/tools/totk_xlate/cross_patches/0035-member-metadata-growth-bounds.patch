+// Annotations may precede type declarations. Bound member metadata storage,
+// not declared struct shape, before map insertion or noexcept vector growth.
+static void precharge_member_metadata_growth(const Meta *existing, uint32_t index)
+{
+	const uint64_t limit = UINT64_C(256) * 1024 * 1024;
+	const uint64_t size_limit = uint64_t((std::numeric_limits<size_t>::max)());
+	const uint64_t requested = uint64_t(index) + 1;
+	const uint64_t old_size = existing ? existing->members.size() : 0;
+	const uint64_t required = (std::max)(old_size, requested);
+	const uint64_t element_size = sizeof(Meta::Decoration);
+	if (required > 262144 || required > size_limit / element_size ||
+	    required > size_limit / 2 || required > limit / element_size)
+		throw canopy_cross_budget::failure{5};
+
+	const uint64_t added = required - old_size;
+	const uint64_t capacity = existing ? existing->members.capacity() : 0;
+	uint64_t bytes = 0, work = 1 + added;
+	if (required > capacity)
+	{
+		// Vector<Decoration> is the pinned SmallVector<T, 0>: no inline slots.
+		uint64_t target = capacity ? capacity : 1;
+		// required <= 262144; at most 18 doublings. No inventory credit.
+		while (target < required)
+		{
+			if (target > size_limit / 2 || target > (limit / element_size) / 2)
+				throw canopy_cross_budget::failure{5};
+			target *= 2;
+		}
+		if (target > size_limit / element_size || target > limit / element_size)
+			throw canopy_cross_budget::failure{5};
+		bytes = target * element_size; // The entire replacement allocation.
+		work += old_size; // reserve moves old rows; resize constructs added rows.
+	}
+	canopy_cross_budget::step(work, added, bytes);
+}
