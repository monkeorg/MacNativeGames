+// Closed source-access floors for supported type declarations and constants.
+// These are operand availability checks, not full SPIR-V grammar validation.
+static uint32_t declaration_constant_operand_minimum(Op op)
+{
+	switch (op)
+	{
+	case OpTypeVoid:
+	case OpTypeBool:
+	case OpTypeSampler:
+	case OpTypeStruct:
+	case OpTypeAccelerationStructureKHR:
+	case OpTypeRayQueryKHR:
+		return 1;
+
+	case OpTypeFloat:
+	case OpTypeRuntimeArray:
+	case OpTypeSampledImage:
+	case OpTypeUntypedPointerKHR:
+	case OpTypeForwardPointer:
+	case OpTypeFunction:
+	case OpTypeTensorARM:
+	case OpTypeBufferEXT:
+	case OpUndef:
+	case OpSpecConstantFalse:
+	case OpConstantFalse:
+	case OpSpecConstantTrue:
+	case OpConstantTrue:
+	case OpConstantNull:
+	case OpSpecConstantComposite:
+	case OpConstantComposite:
+	case OpConstantDataKHR:
+	case OpSpecConstantDataKHR:
+		return 2;
+
+	case OpTypeInt:
+	case OpTypeVector:
+	case OpTypeMatrix:
+	case OpTypeCooperativeVectorNV:
+	case OpTypeArray:
+	case OpTypePointer:
+	case OpSpecConstant:
+	case OpConstant:
+	case OpConstantCompositeReplicateEXT:
+	case OpSpecConstantCompositeReplicateEXT:
+	case OpConstantSizeOfEXT:
+	case OpSpecConstantOp:
+		return 3;
+
+	case OpTypeCooperativeMatrixKHR:
+		return 6;
+	case OpTypeImage:
+		return 8;
+	default:
+		return 0;
+	}
+}
