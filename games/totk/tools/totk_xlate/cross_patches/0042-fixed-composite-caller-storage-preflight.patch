+	// Caller-side preflight, before Variant/ObjectPool acquires a constructor
+	// slot. This checks fixed storage availability, not full type equivalence.
+	static void validate_fixed_composite_storage(const SPIRType &result_type,
+	                                             const SPIRConstant *const *elements, uint32_t count)
+	{
+		if (!elements || count == 0 || count > 4 || result_type.columns == 0 ||
+		    result_type.columns > 4 || result_type.vecsize == 0 || result_type.vecsize > 4)
+			SPIRV_CROSS_THROW("Composite constant exceeds fixed storage or has no elements.");
+		// count is already bounded to 1..4; no input-loop inventory credit.
+		for (uint32_t i = 0; i < count; i++)
+		{
+			if (!elements[i] || elements[i]->m.columns == 0 || elements[i]->m.columns > 4 ||
+			    elements[i]->m.c[0].vecsize == 0 || elements[i]->m.c[0].vecsize > 4)
+				SPIRV_CROSS_THROW("Composite constituent exceeds fixed storage or is unavailable.");
+		}
 	}
 
