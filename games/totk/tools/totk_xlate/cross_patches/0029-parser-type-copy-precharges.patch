+// Parser-local accounting before type copies enter Variant/ObjectPool ownership.
+// These four SmallVector fields use default inline capacity 8. Do not insert
+// throwing callbacks inside their noexcept reserve/copy/append operations.
+static uint64_t parser_type_vector_copy_bytes(size_t count, size_t element_size, bool append)
+{
+	const uint64_t limit = UINT64_C(256) * 1024 * 1024;
+	if (!element_size || count > limit / element_size)
+		throw canopy_cross_budget::failure{5};
+	uint64_t capacity = 8;
+	// Fixed accounting loop: count <= 256 MiB / element_size, at most 25 doublings.
+	while (capacity < count)
+	{
+		if (capacity > limit / 2)
+			throw canopy_cross_budget::failure{5};
+		capacity *= 2;
+	}
+	if (capacity > limit / element_size)
+		throw canopy_cross_budget::failure{5};
+	uint64_t bytes = count > 8 ? capacity * element_size : 0;
+	// Copy may allocate capacity, then the immediate append may allocate twice
+	// that capacity while the old copy is still live. Charge both allocations.
+	if (append && count == capacity)
+	{
+		if (capacity > limit / 2 || capacity * 2 > limit / element_size)
+			throw canopy_cross_budget::failure{5};
+		uint64_t growth = capacity * 2 * element_size;
+		if (growth > limit - bytes)
+			throw canopy_cross_budget::failure{5};
+		bytes += growth;
+	}
+	return bytes;
+}
+
+static void parser_precharge_type_copy(const SPIRType &source, bool append_array_dimension)
+{
+	const uint64_t limit = UINT64_C(256) * 1024 * 1024;
+	uint64_t bytes = 0, work = append_array_dimension ? 3 : 1;
+	const auto charge = [&](size_t count, size_t element_size, bool append) {
+		uint64_t amount = parser_type_vector_copy_bytes(count, element_size, append);
+		if (amount > limit - bytes)
+			throw canopy_cross_budget::failure{5};
+		bytes += amount;
+		work += count; // Each count is already bounded by limit / element_size.
+	};
+	charge(source.array.size(), sizeof(source.array[0]), append_array_dimension);
+	charge(source.array_size_literal.size(), sizeof(source.array_size_literal[0]), append_array_dimension);
+	charge(source.member_types.size(), sizeof(source.member_types[0]), false);
+	charge(source.member_type_index_redirection.size(), sizeof(source.member_type_index_redirection[0]), false);
+	canopy_cross_budget::step(work, 0, bytes);
+}
