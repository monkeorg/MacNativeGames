--- /dev/null
+++ b/src/Ryujinx.Common/Utilities/CanopyTranslationGuard.cs
@@ -0,0 +1,26 @@
+using System;
+namespace Ryujinx.Common.Utilities
+{
+    public sealed class CanopyBudgetExceededException : Exception { }
+    // Null for the original desktop CLI. Only the bounded NativeAOT request
+    // owner installs a thread-local callback and clears it in finally.
+    public static class CanopyTranslationGuard
+    {
+        [ThreadStatic] public static Action<ulong,ulong,ulong> Checkpoint;
+        [ThreadStatic] public static Action Cleanup;
+        [ThreadStatic] static int depth;
+        public static void Step(ulong work=1,ulong nodes=0,ulong bytes=0) => Checkpoint?.Invoke(work,nodes,bytes);
+        public static void ResetDepth() => depth=0;
+        public readonly struct Scope : IDisposable
+        {
+            readonly bool active;
+            internal Scope(bool value) { active=value; }
+            public void Dispose() { if(active)depth--; }
+        }
+        public static Scope Enter()
+        {
+            if(Checkpoint==null)return new Scope(false);
+            Step();if(++depth>256)throw new CanopyBudgetExceededException();return new Scope(true);
+        }
+    }
+}
